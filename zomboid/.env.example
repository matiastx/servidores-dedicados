# Plantilla de variables de entorno para el servidor de Zomboid.
# NO subir el .env real con secretos al repo: las secretos viven en Coolify
# (Resource > Environment Variables). Este archivo es solo la referencia.

# --- Admin ---
ADMINUSERNAME=admin
# Obligatoria en el PRIMER arranque. El entrypoint la pasa como argumento del
# server y queda en claro en los logs: eliminarla del panel apenas el mundo
# este creado.
ADMINPASSWORD=CAMBIAR_ESTA_CLAVE
# Contrasena de RCON (herramientas remotas de administracion).
RCONPASSWORD=

# --- Identidad del server ---
# Sin espacios ni caracteres especiales.
SERVERNAME=ZomboidMGTSolutions
# Presets que trae la imagen en Build 42:
# Apocalypse | Extinction | Outbreak | Rising | SixMonthsLater
# (los presets Survival/Beginner/Builder de B41 ya no existen: el entrypoint
# aborta el arranque si el preset no esta en la imagen).
SERVERPRESET=Apocalypse
# true = visible en el navegador del juego; false = se entra por IP:puerto.
PUBLIC=true
DISPLAYNAME=MGTSolutions-Zomboid

# --- Puertos ---
PORT=16261
UDPPORT=16262

# --- Memoria de la JVM ---
# Heap del server. Con 8 slots: 3072m-4096m.
MEMORY=4096m
# Si se definen, tienen prioridad sobre MEMORY.
MIN_MEMORY=
MAX_MEMORY=

# --- Mods ---
# workshop,steam,mods (orden de carga).
MODFOLDERS=workshop,steam,mods
# IDs de Steam Workshop separados por ';'. Vacio = limpia WorkshopItems del INI.
WORKSHOP_IDS=
# IDs de mods locales separados por ';'. Vacio = limpia Mods del INI.
MOD_IDS=
# 1 = el container NO toca Mods/WorkshopItems del INI.
SELF_MANAGED_MODS=False

# --- Red y seguridad ---
STEAMVAC=True
# True = permite entrar sin cuenta de Steam (necesita el rango TCP abierto).
NOSTEAM=False
# IP/interfaz donde escucha el server. Vacio = todas.
IP=

# --- Varios ---
# LANG debe existir en la imagen (es_ES.UTF-8 viene en el build por defecto).
LANG=es_ES.UTF-8
# true = actualiza el juego en cada arranque (lento).
FORCEUPDATE=False
# Soft reset (esta roto en la imagen upstream, no usarlo).
SOFTRESET=False
# true = sobreescribe el SandboxVars con el preset.
SERVERPRESETREPLACE=False
DEBUG=False
