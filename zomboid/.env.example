# Plantilla de variables de entorno para el servidor de Zomboid.
# NO subir el .env real con secretos al repo: las secretos viven en Coolify
# (Resource > Environment Variables). Este archivo es solo la referencia.

# --- Admin ---
ADMINUSERNAME=admin
# ADMINPASSWORD NO va en el compose en produccion: el entrypoint la pasa como
# argumento del server y queda en claro en los logs. Solo hace falta para crear
# el mundo por primera vez (ver README.md > Arranque). Descomentar la linea
# "ADMINPASSWORD: ${ADMINPASSWORD}" del compose solo para ese caso.
# ADMINPASSWORD=CAMBIAR_ESTA_CLAVE
# Contrasena de RCON (administracion remota). Se marca como secreta en Coolify.
RCONPASSWORD=

# --- Identidad del server ---
# Sin espacios ni caracteres especiales.
SERVERNAME=ZomboidMGTSolutions
# Presets que trae la imagen en Build 42:
# Apocalypse | Extinction | Outbreak | Rising | SixMonthsLater
# (los presets Survival/Beginner/Builder de B41 ya no existen: el entrypoint
# aborta el arranque si el preset no esta en la imagen).
SERVERPRESET=Apocalypse
# true = el server se anuncia en projectzomboid.com / Steam. El listado que ve
# el jugador en el juego ("Internet") lo sirve Steam y solo funciona con
# NOSTEAM=False; con NOSTEAM=True hay que entrar por IP:puerto.
PUBLIC=true
DISPLAYNAME=MGTSolutions-Zomboid

# --- Puertos ---
PORT=16261
UDPPORT=16262

# --- Memoria de la JVM ---
# Heap del server. Con 8 slots en un VPS de 8 GB compartido: 3072m.
# El limite del contenedor va en el compose (mem_limit / cpus).
MEMORY=3072m
# Si se definen, tienen prioridad sobre MEMORY.
MIN_MEMORY=
MAX_MEMORY=

# --- Mods ---
# workshop,steam,mods (orden de carga).
MODFOLDERS=workshop,steam,mods
# IDs de Steam Workshop separados por ';'. Vacio = limpia WorkshopItems del INI.
WORKSHOP_IDS=
# IDs de mods locales separados por ';'. Vacio = limpia Mods del INI.
MOD_IDS=
# 1 = el container NO toca Mods/WorkshopItems del INI.
SELF_MANAGED_MODS=False

# --- Red y seguridad ---
STEAMVAC=True
# True = -nosteam: entrada solo por IP y el server es invisible en el listado
# publico del juego. False = Steam habilitado: se registra en Steam y aparece
# en el navegador de servidores.
NOSTEAM=False
# Puertos del Steam GameServer (por defecto 8766/8767). Deben caer dentro de
# algun rango que el router de la red reenvie: en este despliegue el router de
# Cablevision solo reenvia 16261-16272, por eso se usan 16271/16272.
STEAMPORT1=16271
STEAMPORT2=16272
# IP/interfaz donde escucha el server. Vacio = todas.
# OJO: no confundir con la IP que se anuncia en projectzomboid.com, que va en
# el INI (server_browser_announced_ip).
IP=

# --- Varios ---
# LANG debe existir en la imagen (es_ES.UTF-8 viene en el build por defecto).
LANG=es_ES.UTF-8
# true = actualiza el juego en cada arranque (lento).
FORCEUPDATE=False
# Soft reset (esta roto en la imagen upstream, no usarlo).
SOFTRESET=False
# true = sobreescribe el SandboxVars con el preset.
SERVERPRESETREPLACE=False
DEBUG=False
